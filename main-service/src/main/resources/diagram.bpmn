  <bpmn:process id="create_vacancy_proccess" name="create_vacancy_proccess" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="Event_116yk2s">
      <bpmn:outgoing>Flow_01poldb</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_01poldb" sourceRef="Event_116yk2s" targetRef="data_input" />
    <bpmn:userTask id="data_input" name="Ввод данных о вакансии">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="title" label="title" type="string" defaultValue="Vacancy">
            <camunda:properties />
          </camunda:formField>
          <camunda:formField id="description" label="description" type="string" defaultValue="description.." />
          <camunda:formField id="resumeRequired" label="resumeRequired" type="boolean" defaultValue="false" />
          <camunda:formField id="coverLetterRequired" label="coverLetterRequired" type="boolean" defaultValue="false" />
          <camunda:formField id="keywords" label="keywords" type="string" defaultValue="java, spring, hibernate" />
          <camunda:formField id="pendingLimit" label="pendingLimit" type="long" defaultValue="100" />
          <camunda:formField id="employerId" label="employerId" type="long" defaultValue="1" />
          <camunda:formField id="userId" label="userId" type="long" defaultValue="1" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01poldb</bpmn:incoming>
      <bpmn:outgoing>Flow_1ax3g4y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1ax3g4y" sourceRef="data_input" targetRef="create_vacancy" />
    <bpmn:serviceTask id="create_vacancy" name="Создание вакансии" camunda:delegateExpression="${createVacancyDelegator}">
      <bpmn:incoming>Flow_1ax3g4y</bpmn:incoming>
      <bpmn:outgoing>Flow_0nim53p</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_13frlpq">
      <bpmn:incoming>Flow_0nim53p</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0nim53p" sourceRef="create_vacancy" targetRef="Event_13frlpq" />
  </bpmn:process>
  <bpmn:process id="add_application_review" name="add_application_review" isExecutable="true" camunda:historyTimeToLive="30">

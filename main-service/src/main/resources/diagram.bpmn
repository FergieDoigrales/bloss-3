      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="applicationId" label="applicationId" type="long" defaultValue="1" />
          <camunda:formField id="decision" label="decision" type="string" defaultValue="reject" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bcgqs5</bpmn:incoming>
      <bpmn:outgoing>Flow_0zw5rhe</bpmn:outgoing>

      <bpmn:incoming>Flow_0fk772a</bpmn:incoming>
      <bpmn:outgoing>Flow_1hyak8k</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1hyak8k" sourceRef="Gateway_0thfsi7" targetRef="Event_05lyf2l" />
    <bpmn:exclusiveGateway id="Gateway_0mjetfs">
      <bpmn:incoming>Flow_0zw5rhe</bpmn:incoming>
      <bpmn:outgoing>Flow_18ivkq5</bpmn:outgoing>
      <bpmn:outgoing>Flow_0w5p0rf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_18ivkq5" sourceRef="Gateway_0mjetfs" targetRef="Activity_1gbcfnz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "accept"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0zw5rhe" sourceRef="application_data" targetRef="Gateway_0mjetfs" />
    <bpmn:serviceTask id="Activity_05riahq" name="Пригласить на собеседование" camunda:delegateExpression="${AcceptApplicationDelegator}">
      <bpmn:incoming>Flow_0w5p0rf</bpmn:incoming>
      <bpmn:outgoing>Flow_0fk772a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0w5p0rf" sourceRef="Gateway_0mjetfs" targetRef="Activity_05riahq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "reject"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0fk772a" sourceRef="Activity_05riahq" targetRef="Gateway_0thfsi7" />
  </bpmn:process>
